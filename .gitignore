# Real site configs and secrets never get committed.
config/*.local.json
!config/*.local.example.json
*.local.json
!*.local.example.json
*.local.env
!*.local.example.env
.env
.env.*
!.env.example
secrets/

# Certificates and keys
*.pem
*.key
*.crt
*.p12
*.pfx
*.der

# Captures and logs can contain IMSI/MEID and credentials
*.pcap
*.pcapng
logs/
*.log
run/

# Third-party tool clones (re-clone on demand; see docs/03)
Sprint-Airave-Airvana-2.5-Root/

# Python test artifacts
__pycache__/
.pytest_cache/

# OS / editor
.DS_Store
.vscode/
.idea/
