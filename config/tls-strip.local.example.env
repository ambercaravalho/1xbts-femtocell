# Copy to config/tls-strip.local.env (gitignored). Read by docker/tls-strip/compose.yml
# and scripts/tls-strip.sh. Plain KEY=VALUE lines, no quotes or shell syntax.

# Plaintext mail listeners on 10.55.0.1 for handset mail clients (SSL off), each
# upgraded to verified TLS upstream. Comma-separated LISTEN_PORT=HOST:PORT[/PROTO]:
#   no /PROTO     upstream speaks implicit TLS (IMAPS 993, POP3S 995, SMTPS 465)
#   /imap /pop3 /smtp   upstream is plaintext + STARTTLS (143, 110, 587)
# Leave empty to run no mail listeners. Example:
#   MAIL_UPSTREAMS=1143=imap.example.com:993,1110=pop.example.com:995,1587=smtp.example.com:587/smtp
MAIL_UPSTREAMS=

# Hosts (and their subdomains) always fetched over plain HTTP, never upgraded.
# For sites whose port 443 serves a different site than port 80.
STRIP_PASSTHROUGH_HOSTS=

# Seconds to wait for a host to answer HTTPS on port 443 before it stays on plain
# HTTP (default 4).
STRIP_PROBE_TIMEOUT=
